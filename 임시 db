gitignore에 반드시 DB 추가할 것!
.gitignore:
*.db
*.sqlite(
.sqlite 확장자는 SQLite 데이터베이스 파일을 나타냅니다. SQLite는 서버가 필요 없는 가벼운 파일 기반 데이터베이스로, 주로 애플리케이션에서 간단한 데이터베이스 용도로 사용됩니다.
***.sqlite**는 Git이 모든 .sqlite 파일을 무시하도록 하는 규칙입니다. 즉, .sqlite 확장자를 가진 파일이 프로젝트 디렉토리 내에 있으면, Git은 이를 버전 관리 목록에서 제외하고 추적하지 않게 됩니다.
)


CREATE TABLE users (
    id INT PRIMARY KEY AUTO_INCREMENT,   -- 회원 ID (자동 증가)
    username VARCHAR(50) UNIQUE NOT NULL, -- 사용자 이름 (중복 불가)
    password VARCHAR(255) NOT NULL,       -- 비밀번호 (해시 저장 필요)
    email VARCHAR(100) UNIQUE NOT NULL,   -- 이메일 (중복 불가)
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP -- 계정 생성 날짜
);
CREATE TABLE weather (
    id INT PRIMARY KEY AUTO_INCREMENT,
    location VARCHAR(100) NOT NULL,  -- 지역명 추가
    date DATE NOT NULL,
    time TIME NOT NULL,
    temperature DECIMAL(5,2) NOT NULL,
    humidity INT NOT NULL,
    weather_condition VARCHAR(50) NOT NULL,
    wind_speed DECIMAL(5,2),
    last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);
CREATE TABLE weather_api_log (
    id INT PRIMARY KEY AUTO_INCREMENT,
    api_source VARCHAR(100),   -- API 제공 업체
    temperature DECIMAL(5,2), 
    humidity INT, 
    weather_condition VARCHAR(50), 
    fetched_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE clothes (
    id INT PRIMARY KEY AUTO_INCREMENT,          -- 의류의 고유 식별자
    category VARCHAR(50),                       -- 의류의 카테고리 (예: 자켓, 티셔츠)
    name VARCHAR(100),                          -- 의류의 이름
    temperature_min DECIMAL(5,2),               -- 이 의류가 적합한 최소 온도
    temperature_max DECIMAL(5,2)                -- 이 의류가 적합한 최대 온도
);
CREATE TABLE clothes_recommendations (
    id INT PRIMARY KEY AUTO_INCREMENT,          -- 고유 식별자
    user_id INT,                                -- 사용자 ID
    weather_id INT,                             -- 날씨 ID
    clothes_id INT,                             -- 추천된 의류의 ID
    recommended_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- 추천된 시간
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE, -- 사용자 ID가 삭제될 때 관련 데이터도 삭제
    FOREIGN KEY (weather_id) REFERENCES weather(id) ON DELETE CASCADE, -- 날씨 ID가 삭제될 때 관련 데이터도 삭제
    FOREIGN KEY (clothes_id) REFERENCES clothes(id) ON DELETE CASCADE -- 의류 ID가 삭제될 때 관련 데이터도 삭제
);
CREATE TABLE posts (
    id INT PRIMARY KEY AUTO_INCREMENT,          -- 고유 식별자
    user_id INT,                                -- 작성자 사용자 ID
    title VARCHAR(255),                         -- 게시글 제목
    content TEXT,                               -- 게시글 내용
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- 게시글 작성 시간
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE -- 사용자 ID가 삭제될 때 관련 데이터도 삭제
);
CREATE TABLE comments (
    id INT PRIMARY KEY AUTO_INCREMENT,          -- 고유 식별자
    user_id INT,                                -- 댓글을 단 사용자 ID
    post_id INT,                                -- 댓글이 달린 게시글 ID
    content TEXT,                               -- 댓글 내용
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- 댓글 작성 시간
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE, -- 사용자 ID가 삭제될 때 관련 데이터도 삭제
    FOREIGN KEY (post_id) REFERENCES posts(id) ON DELETE CASCADE -- 게시글 ID가 삭제될 때 관련 데이터도 삭제
);
CREATE TABLE likes (
    id INT PRIMARY KEY AUTO_INCREMENT,          -- 고유 식별자
    user_id INT,                                -- '좋아요'를 누른 사용자 ID
    post_id INT,                                -- '좋아요'가 눌린 게시글 ID
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- '좋아요'를 누른 시간
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE, -- 사용자 ID가 삭제될 때 관련 데이터도 삭제
    FOREIGN KEY (post_id) REFERENCES posts(id) ON DELETE CASCADE -- 게시글 ID가 삭제될 때 관련 데이터도 삭제
);


